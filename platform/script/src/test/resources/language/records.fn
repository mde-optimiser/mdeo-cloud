import { Point, origin } from "./geo.fn"

record Segment(start: Point, end: Point, tags: List<string> = emptyList<string>())

fun construct(): string {
    val p = Point(1.0)
    return p.toString()
}

record Counter(count: int = 0, step: long = 1L, ratio: double? = null, apply: (int) => int = (v) => v + count)

fun fields(): double {
    val s = Segment(end = Point(3.0, 4.0), start = origin())
    s.end.y = 6.0
    return s.end.x * 10.0 + s.end.y
}

fun copies(): string {
    val a = Point(1.0, 2.0, "a")
    val b = a.with(label = "b", x = 5.0)
    return "" + a + " " + b
}

fun equality(): string {
    val a = Point(1.0)
    val b = Point(1.0, 1.0)
    val c = a.with(label = "c")
    return "" + (a == b) + (a === b) + (a == c)
}

fun sets(): int {
    val s = setOf(Point(1.0), Point(1.0), Point(2.0))
    return s.size()
}

fun sharedTags(): int {
    val s = Segment(origin(), origin())
    val t = s.with()
    t.tags.add("x")
    return s.tags.size()
}

fun counters(): string {
    var c = Counter()
    c.count = c.apply(5)
    c.step = c.step + 2L
    return "" + c.count + "," + c.step + "," + c.with(ratio = 0.5).ratio + "," + c.ratio
}

fun vals(flag: boolean): int {
    val v: int
    if (flag) {
        v = 1
    } else {
        v = 2
    }
    return v
}

fun nullable(): double {
    val p: Point? = null
    val q: Point? = Point(2.0)
    return (p?.x ?? -1.0) + (q?.with(x = 3.0)?.x ?? 0.0)
}

fun typeCheck(): boolean {
    val a: Any = Point(1.0)
    return a is Point && !(a is Segment)
}

fun casts(): double {
    val a: Any = Point(4.0)
    val p = a as Point
    val s = a as? Segment
    return p.x + (s?.start?.x ?? 0.5)
}
