import { Money, price, greet as salute } from "./lib.fn"

fun note(log: List<string>, entry: string): string {
    log.add(entry)
    return entry
}

fun imported(): string {
    return salute("Ada") + " " + salute(punctuation = "?", name = "Bob") + " " + salute("Cy", greeting = "Hi")
}

fun importedDefaultsSeeParameters(): string {
    return "" + price(100L) + " " + price(currency = "USD", amount = 50L) + " " + price(20L, discount = 0L)
}

fun overloadsByName(): string {
    val s = "abcdef"
    return s.substring(index = 4) + "|" + s.substring(endIndex = 3, startIndex = 1) + "|" + s.substring(2, endIndex = 4)
}

fun namedLambdaArgument(): boolean {
    val values = listOf(1, 2, 3, 4)
    return values.nMatch(n = 2, iterator = (it) => it > 2) && !values.nMatch(n = 3, iterator = (it) => it > 2)
}

fun namedLambdaOnRecords(): string {
    val moneys = listOf(Money(3L), Money(1L, "USD"), Money(2L))
    val sorted = moneys.sortedBy(iterator = (it) => it.amount)
    var text = ""
    for (m in sorted) {
        text = text + m.amount + m.currency
    }
    return text
}

fun counted(log: List<string>, a: string = note(log, "a"), b: string = note(log, "b")): string {
    return a + b
}

fun defaultsOnlyRunWhenLeftOut(): string {
    val log = emptyList<string>()
    val first = counted(log, b = "B")
    val second = counted(log)
    return first + second + ":" + log.size()
}

fun sumTo(n: int, acc: int = 0): int {
    if (n == 0) {
        return acc
    }
    return sumTo(n - 1, acc = acc + n)
}

fun recursion(): int {
    return sumTo(n = 10)
}

fun widen(a: double, b: long = 1L, c: double? = null): string {
    return "" + a + "/" + b + "/" + c
}

fun wideAndNullableOutOfOrder(): string {
    return widen(b = 2L, a = 3.0) + " " + widen(c = 4.0, a = 1.5) + " " + widen(1.0, c = null)
}

fun label(prefix: string? = null, value: int = 0): string {
    return (prefix ?? "none") + value
}

fun nulls(): string {
    return label(prefix = null, value = 1) + label(value = 2) + label("p")
}

fun insideLambda(): string {
    val suffix = "!"
    val make: (string) => string = (name) => salute(name, punctuation = suffix)
    return make("Eve")
}

fun compose(value: int, first: (int) => int = (v) => v + 1, second: (int) => int = (v) => first(first(v))): int {
    return second(value)
}

fun defaultLambdaUsesEarlierLambda(): int {
    return compose(1) * 100 + compose(1, first = (v) => v * 3)
}

fun pick(a: int, b: int = 20, c: int = 30, d: int = 40): string {
    return "" + a + "," + b + "," + c + "," + d
}

fun skipsMiddleParameters(): string {
    return pick(1, d = 4) + ";" + pick(c = 3, a = 1) + ";" + pick(1, 2, d = 4, c = 3)
}

fun argumentOrder(): string {
    val log = emptyList<string>()
    val result = pick(d = note(log, "d").length(), a = note(log, "a").length(), c = note(log, "cc").length())
    var text = ""
    for (entry in log) {
        text = text + entry
    }
    return text + ":" + result
}
