import { Size, Box, unit } from "./shapes.fn"

record Node(value: int, next: Node? = null)

record Empty()

record Pt(x: double)

record Vec(x: double)

record Bucket(items: List<int>)

record Odd(copy: int, field: string, fields: int, hashCode: int, recordType: string, values: int)

record Mixed(i: int, f: float, l: long, b: boolean, s: string?, d: double?, any: Any?)

record Holder(points: List<Pt> = emptyList<Pt>(), best: Pt? = null)

fun note(log: List<string>, entry: string): string {
    log.add(entry)
    return entry
}

fun importedDefaults(): string {
    val b = Box("b", Size(2.0, 3.0))
    return "" + unit() + " " + b.area + " " + Box(name = "c", area = 0.5).size
}

fun linkedList(): string {
    val list = Node(1, Node(2, Node(3)))
    var sum = 0
    var current: Node? = list
    while (current != null) {
        sum = sum + current!!.value
        current = current!!.next
    }
    return sum + " " + list
}

fun emptyRecords(): string {
    return "" + Empty() + (Empty() == Empty()) + (Empty() === Empty())
}

fun sameShapeDifferentRecords(): boolean {
    val a: Any = Pt(1.0)
    val b: Any = Vec(1.0)
    return a == b
}

fun collectionFieldsCompareByContent(): string {
    val a = Bucket(listOf(1, 2))
    val b = Bucket(listOf(1, 2))
    val equalBefore = a == b
    b.items.add(3)
    return "" + equalBefore + (a == b) + a
}

fun fieldsNamedLikeRuntimeMembers(): string {
    val o = Odd(1, "f", 2, 3, "r", 4)
    o.copy = o.copy + 10
    val c = o.with(values = 40)
    return "" + o + " " + c.copy + c.field + c.fields + c.hashCode + c.recordType + c.values
}

fun allFieldKinds(): string {
    val m = Mixed(1, 2.5f, 3L, true, null, 4.5, "x")
    m.i = m.i + 1
    m.f = m.f * 2.0f
    m.l = m.l * 1000000000000L
    m.b = !m.b
    m.s = "s"
    val n = m.with(d = null, any = 7, s = null)
    return "" + m + " " + n + " " + (n.d ?? -1.0)
}

fun withEvaluationOrder(): string {
    val log = emptyList<string>()
    val base = Mixed(0, 0.0f, 0L, false, null, null, null)
    val copy = base.with(s = note(log, "s"), any = note(log, "any"), b = note(log, "b") == "b")
    var text = ""
    for (entry in log) {
        text = text + entry
    }
    return text + " " + copy.s + copy.any + copy.b
}

fun withReceiverEvaluatedOnce(): string {
    val log = emptyList<string>()
    val copy = Pt(note(log, "made").length() * 1.0).with(x = 9.0)
    return "" + log.size() + copy.x
}

fun withAllFields(): string {
    val b = Box("a", Size(1.0), 1.0)
    val c = b.with(name = "c", size = Size(2.0), area = 4.0)
    return "" + b + " " + c
}

fun withOnImported(): boolean {
    val size = Size(2.0)
    val bigger = size.with(height = 5.0)
    return size.height == 2.0 && bigger.width == 2.0 && bigger.height == 5.0
}

fun lambdasOverRecords(): string {
    val points = listOf(Pt(3.0), Pt(1.0), Pt(2.0))
    val doubled = points.map((p) => p.with(x = p.x * 2.0))
    val big = doubled.filter((p) => p.x > 2.5)
    val sorted = big.sortedBy((p) => p.x)
    var text = ""
    for (p in sorted) {
        text = text + p.x + ";"
    }
    return text + points.first().x + points.exists((p) => p == Pt(1.0))
}

fun nestedMutation(): string {
    val h = Holder()
    h.points.add(Pt(1.0))
    h.points.add(Pt(5.0))
    for (p in h.points) {
        if (h.best == null || p.x > h.best!!.x) {
            h.best = p
        }
    }
    h.best!!.x = 6.0
    return "" + h.points.last().x + " " + h
}

fun recordsInSets(): string {
    val set = emptySet<Pt>()
    set.add(Pt(1.0))
    set.add(Pt(1.0))
    set.add(Pt(2.0))
    return "" + set.size() + set.includes(Pt(2.0)) + set.includes(Pt(3.0))
}

fun reassignRecordVariable(): string {
    var p = Pt(1.0)
    val first = p
    p = p.with(x = 2.0)
    p.x = p.x + 1.0
    return "" + first.x + p.x
}

fun passAndReturn(p: Pt, factor: double = 2.0): Pt {
    p.x = p.x * factor
    return p
}

fun recordsAsParameters(): string {
    val p = Pt(1.5)
    val same = passAndReturn(p)
    val again = passAndReturn(factor = 3.0, p = same)
    return "" + p.x + (p === again)
}

fun defaultRecordsAreFresh(): int {
    val a = Holder()
    val b = Holder()
    a.points.add(Pt(1.0))
    return b.points.size()
}

fun nullableRecordFields(): string {
    val h = Holder()
    val missing = h.best?.x ?? -1.0
    h.best = Pt(4.0)
    return "" + missing + (h.best?.x ?? -1.0)
}

fun nullableDoubleInString(): string {
    val m = Mixed(1, 1.0f, 1L, true, null, 2.5, null)
    return "d=" + m.d + " s=" + m.s + " any=" + m.any
}
