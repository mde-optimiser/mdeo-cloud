problem {
    metamodel = "./deployment.mm"
    model = "./deployment.m"
}

goal {
    import { usedServers, maxOverload } from "./objectives.fn"

    minimize usedServers
    minimize maxOverload
}

search {
    mutations {
        // one file, two operators: small moves and moves of any component
        using "./move.mt" with {
            maxLoad = 4
        }
        using "./move.mt" with {
            maxLoad = 100
        }
        using "./swap.mt"
    }
    crossovers {
        using "./take-tier.mt"
        using "./take-tier.mt" with {
            tier = Tier.FRONTEND
        }
        using "./follow-donors.mt"
    }
}

solver {
    algorithm = NSGAII

    parameters {
        population = 40
        variation = genetic

        crossover {
            rate = 0.9
            parents = 2
            strategy = random
        }

        mutation {
            step = interval(1, 3)
            strategy = random
        }
    }

    termination {
        evolutions = 200
    }
}
