{
    "name": "@mdeo/editor-model",
    "version": "0.2.11",
    "license": "EPL-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mde-optimiser/mdeo-cloud.git",
        "directory": "app/packages/editor-model"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles": {
            "style": "./dist/styles.css",
            "import": "./dist/styles.css",
            "default": "./dist/styles.css"
        }
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "LICENSES"
    ],
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/styles.css --minify",
        "watch:css": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/styles.css --watch"
    },
    "dependencies": {
        "@mdeo/editor-shared": "^0.2.11",
        "@mdeo/protocol-model": "^0.2.11"
    },
    "devDependencies": {
        "@eclipse-glsp/protocol": "^2.8.0",
        "@eclipse-glsp/sprotty": "^2.8.0",
        "@tailwindcss/cli": "^4.3.3",
        "inversify": "^6.2.2",
        "snabbdom": "~3.5.1",
        "tailwindcss": "^4.3.3"
    }
}
