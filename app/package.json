{
    "name": "mdeo",
    "version": "0.2.11",
    "private": true,
    "license": "EPL-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mde-optimiser/mdeo-cloud.git",
        "directory": "app"
    },
    "scripts": {
        "build": "npm run build:packages && npm run build:css && npm run build:workbench",
        "build:packages": "tsc -b tsconfig.build.json",
        "build:workbench": "npm run -w @mdeo/workbench build",
        "build:css": "npm run -w @mdeo/editor-metamodel build:css && npm run -w @mdeo/editor-model build:css && npm run -w @mdeo/editor-model-transformation build:css",
        "watch": "tsc -b tsconfig.build.json --watch",
        "dev": "npm run -w @mdeo/workbench dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint --fix",
        "lint:check": "eslint",
        "lint:versions": "syncpack lint",
        "set-version": "npm version --workspaces --include-workspace-root --no-git-tag-version --no-workspaces-update --allow-same-version",
        "postset-version": "syncpack fix && syncpack fix && prettier --write package.json \"packages/*/package.json\" && npm install --package-lock-only"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "syncpack": "^15.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "workspaces": [
        "packages/*"
    ],
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none",
        "printWidth": 120,
        "overrides": [
            {
                "files": [
                    "*.md",
                    "*.yml",
                    "*.yaml"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "overrides": {
        "typir-langium": {
            "langium": "~4.4.0"
        },
        "vscode-languageserver-protocol": "3.18.4",
        "vscode-languageserver-types": "3.18.4",
        "dompurify": "^3.4.17"
    }
}
